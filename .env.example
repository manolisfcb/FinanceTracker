# Copy to .env and fill in real values. Never commit the real .env.

# development | production | testing
ENV=development

HOST=127.0.0.1
PORT=5000

# SQLAlchemy connection string. Defaults to a local SQLite file in
# development if unset; required in production.
DATABASE_URL=sqlite:///finance.db

# Required in production — the app fails to start without these.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Market data provider for the Asset catalog (src/services/market_data).
# Only "yahoo" (yfinance) is implemented today.
MARKET_DATA_PROVIDER=yahoo

# SEC EDGAR requires a User-Agent with the app name and a contact email
# (fair access policy) — requests without it get a 403.
SEC_EDGAR_USER_AGENT=TrueNorth Analytics your-email@example.com

# News sources for the company feed and inbox (comma-separated): yahoo, google.
# Both are free and need no API key. Leave empty to turn news ingestion off.
NEWS_PROVIDERS=yahoo,google
