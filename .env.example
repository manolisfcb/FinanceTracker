# Copy to .env and fill in real values. Never commit the real .env.

# development | production | testing
ENV=development

HOST=127.0.0.1
PORT=5000

# SQLAlchemy connection string. Defaults to a local SQLite file in
# development if unset; required in production.
DATABASE_URL=sqlite:///finance.db

# Required in production — the app fails to start without these.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=
